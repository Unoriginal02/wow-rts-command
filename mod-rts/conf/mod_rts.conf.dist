[worldserver]

#
#    RTS.Camera.Height
#        Description: How far above your character the detached camera starts,
#                     in yards. High enough to read the ground, low enough that
#                     you can still tell your units apart.
#        Default:     12.0
#

RTS.Camera.Height = 12.0

#
#    RTS.Camera.Speed
#        Description: Camera fly speed, as a multiple of base run speed. This is
#                     applied to the invisible creature the client is flying, so
#                     it behaves exactly like any other movement speed.
#        Range:       0.5 - 50.0
#        Default:     3.0
#

RTS.Camera.Speed = 3.0

#
#    RTS.Camera.Fly
#        Description: Whether the camera flies or pans flat.
#
#                     1 (flight) is the old behaviour and the wrong one for an
#                     RTS: the client moves the camera along the VIEW vector, so
#                     tilting down and pressing forward makes you descend. Space
#                     and X raise and lower it.
#
#                     0 (default) leaves gravity disabled but flight off, so the
#                     client moves the camera flat across the map and the tilt
#                     only changes what you see -- the WC3 behaviour. Height then
#                     comes from Q/E in the addon, which zoom the camera, since
#                     space and X are flight actions and stop working.
#
#                     Switchable in game with /rts cam fly.
#        Default:     0
#

RTS.Camera.Fly = 0

#
#    RTS.Camera.LiftSpeed
#        Description: How fast Q and E raise and lower the camera, in yards per
#                     second. The camera is possessed, so height is moved by the
#                     server in small steps on its own tick rather than by the
#                     client -- a slower rate is smoother, not coarser.
#                     0 means MATCH the horizontal speed above, which is
#                     what you normally want -- rising should not feel
#                     like a different vehicle from panning.
#        Default:     0
#

RTS.Camera.LiftSpeed = 0

#
#    RTS.Camera.PivotDistance
#        A que distancia por delante de la camara esta el punto sobre el que
#        pivotan Q y E, en yardas.
#
#        Q/E ya no giran la camara sobre si misma: la llevan en arco alrededor
#        de este punto, que se queda quieto mientras lo ves desde otro lado.
#        Mas distancia = arco mas amplio y giro mas suave; menos = giro mas
#        cerrado, casi sobre el sitio.
#
#        Por defecto: 12.0
#

RTS.Camera.PivotDistance = 12.0

#
#    RTS.Camera.PivotSpeed
#        Radianes por segundo del pivote. 1.6 son unos 92 grados/s.
#
#        La camara esta poseida, asi que orbitarla es el servidor moviendola
#        con NearTeleportTo en cada tick -- el mismo camino que las teclas de
#        altura. Si se nota a pasos en vez de fluido, este es el dial: mas
#        despacio con el mismo intervalo de tick se ve MAS suave, no menos.
#
#        Por defecto: 1.6
#

RTS.Camera.PivotSpeed = 1.6

#
#    RTS.CatchUp.Train
#        Al subir de nivel Y al entrar al mundo, aprender gratis todo lo que su
#        entrenador le venderia a ese nivel: habilidades de clase Y de arma.
#
#        Entrar al mundo cuenta porque es cuando aparece un alt metido con
#        ".playerbots bot add": ese no va a subir de nivel justo entonces, y sin
#        esa segunda puerta se quedaria atrasado. Si ya esta al dia no se toca
#        nada -- lo que ya sabe se salta solo.
#
#        Vale para los bots y para tu personaje. Lo que decide que se puede
#        aprender no es una lista nuestra: son los datos del entrenador del
#        mundo, los mismos que mira el comando ".learn all my trainer". Lo unico
#        que se salta es el precio.
#
#        Las habilidades de arma vienen de los maestros de armas, que son once
#        PNJ repartidos por el mundo; entre todos cubren los catorce hechizos de
#        arma del juego y el nucleo filtra por clase y raza.
#
#        Por defecto: 1
#

RTS.CatchUp.Train = 1

#
#    RTS.CatchUp.ClassQuest
#        Al subir de nivel Y al entrar al mundo, dar la mision de clase que le
#        toque.
#
#        UNA SOLA A LA VEZ: si ya lleva una mision de clase en el registro, no
#        se le da otra hasta que la quite de en medio -- entregandola en su
#        entrenador, que es donde se entrega siempre, o abandonandola.
#
#        Si la mision que le toca cuelga de otras que no hizo, se le hacen esas
#        primero de verdad: se le dan, se completan y se cobran, con recompensa
#        elegida automaticamente. No se marcan y ya, porque la recompensa de una
#        mision de clase suele ser un hechizo que no vende ningun entrenador.
#
#        Por defecto: 1
#

RTS.CatchUp.ClassQuest = 1

#
#    RTS.Pet.Happy
#        Dejar la felicidad de las mascotas de cazador clavada en el maximo.
#
#        La felicidad es una correa que aqui no ata a nadie. Baja sola (670
#        cada 7,5 segundos, y mas rapido en combate), morir cuesta 333.000 de
#        golpe -- un tercio entero de la barra -- y solo sube dandole de comer,
#        que es un hechizo del dueno: a la mascota de un bot no le da de comer
#        nadie, porque el bot no sabe y tu no puedes. Una mascota infeliz pega
#        menos y acaba desobedeciendo, asi que lo que la correa produce no es
#        una decision del jugador, es un impuesto que se cobra solo.
#
#        Vale para TODOS los cazadores conectados, los tuyos y los bots. Se
#        aplica en el tick del mundo, una vez por segundo, y no cuesta nada
#        mientras no haya bajado: escribir el valor que ya hay no manda paquete.
#
#        0 devuelve el comportamiento del juego, con su hambre y su comida.
#
#        Por defecto: 1
#

RTS.Pet.Happy = 1

#
#    RTS.Dungeon.ReviveAtDoor
#        Morir dentro de una instancia te deja VIVO en la puerta, por fuera, en
#        vez de fantasma buscando el camino de vuelta. Vale para tus bots y para
#        tu heroe.
#
#        El sitio no es una lista de coordenadas nuestra: es la salida que el
#        propio nucleo tiene apuntada para esa instancia (`GetGoBackTrigger`),
#        la misma que usa el cuando tiene que sacar a alguien de un mapa que ya
#        no existe. Si un mapa no la tiene, no se toca a nadie.
#
#        Se revive un par de segundos despues de morir: ni en medio del trabajo
#        del nucleo, ni tan tarde que parezca que no va a pasar nada.
#
#        0 devuelve el comportamiento del juego, con su cementerio y su carrera
#        de cadaver.
#
#        Por defecto: 1
#

RTS.Dungeon.ReviveAtDoor = 1
